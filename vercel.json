{
  "rewrites": [
    {
      "source": "/festa",
      "destination": "/festa/index.html"
    },
    {
      "source": "/festa/",
      "destination": "/festa/index.html"
    },
    {
      "source": "/guia",
      "destination": "/GUIA/index.html"
    },
    {
      "source": "/guia/",
      "destination": "/GUIA/index.html"
    },
    {
      "source": "/GUIA",
      "destination": "/GUIA/index.html"
    },
    {
      "source": "/experimental",
      "destination": "https://personal-kids-app.vercel.app/experimental"
    },
    {
      "source": "/experimental/",
      "destination": "https://personal-kids-app.vercel.app/experimental"
    },
    {
      "source": "/evento",
      "destination": "https://personal-kids-app.vercel.app/evento"
    },
    {
      "source": "/evento/",
      "destination": "https://personal-kids-app.vercel.app/evento"
    },
    {
      "source": "/equipe",
      "destination": "https://personal-kids-app.vercel.app/equipe"
    },
    {
      "source": "/equipe/",
      "destination": "https://personal-kids-app.vercel.app/equipe"
    },
    {
      "source": "/inscricao",
      "destination": "https://personal-kids-app.vercel.app/inscricao"
    },
    {
      "source": "/inscricao/",
      "destination": "https://personal-kids-app.vercel.app/inscricao"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}